# The signals of chapter 6's FSM waveform, for scripts/vcd_wave.py: path, label, format,
# for the core's own signals the report's colour for the core, and the states in which the
# value is the one to read. The state names are the two-letter codes of the FSM figure: a
# full name does not fit in one cycle. mem_addr is marked where the bus uses it, with the
# read strobe, in the wait state after it and with the byte mask; write_rd where it writes.
uut.clk                  clk          clock
cpu.control.state        state        0=FI,1=WI,2=FR,3=EX,4=LD,5=WD,6=ST   0072b2
cpu.control.latch_instr  latch_instr  bit                                  0072b2  @WI
cpu.control.read_regs    read_regs    bit                                  0072b2  @FR
cpu.control.update_pc    update_pc    bit                                  0072b2  @EX
cpu.control.write_rd     write_rd     bit                                  0072b2  @EX&write_rd,WD
cpu.pc                   pc           hex                                  0072b2  @FI
cpu.instr                instr        hex                                  0072b2  @FR
uut.mem_addr             mem_addr     hex                                          @FI,WI,LD,WD,ST
uut.mem_rstrb            mem_rstrb    bit                                          @FI,LD
uut.mem_rdata            mem_rdata    hex                                          @WI,WD
uut.mem_wmask            mem_wmask    hex                                          @ST
uut.mem_wdata            mem_wdata    hex                                          @ST
uut.LEDS                 LEDS         hex
